DB_CONNECTION=sqlite
DB_DATABASE=db/nairobi_traders.sqlite
PDF_SERVICE_URL=http://localhost:5000/generate-receipt
APP_ENV=development
APP_PORT=8000
PYTHON_SERVICE_PORT=5000

# ==============================================================================
# SAFARICOM M-PESA DARAJA CONFIGURATION
# ==============================================================================
# Set to 'false' to trigger REAL STK pushes to real customer mobile phones.
# Set to 'true' to use the fast zero-cost simulator.
MPESA_SIMULATOR_MODE=true

# Environment: 'sandbox' for test keys, or 'live' for real production business money
MPESA_ENVIRONMENT=sandbox

# Daraja Developer App Credentials (from https://developer.safaricom.co.ke)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# Lipa Na M-Pesa Online Passkey (from Daraja portal)
# Note: Below is Safaricom's default public sandbox passkey for shortcode 174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Default fallback shortcode if trader has not set their own Till/Paybill number
MPESA_SHORTCODE=174379

# Public Webhook Callback URL where Safaricom sends payment confirmation.
# When testing locally with real phones, use your Ngrok/tunnel URL:
# e.g. https://your-id.ngrok-free.app/api/mpesa_callback.php
MPESA_CALLBACK_URL=http://localhost:8000/api/mpesa_callback.php
